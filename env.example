# Required
HELIUS_API_KEY=your_helius_api_key
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_key
WALLET_PRIVATE_KEY=your_base58_private_key
DISCORD_WEBHOOK_URL=your_discord_webhook

# Target wallet (buy signal only — sells are ignored)
TARGET_WALLET=93kgxYKex5wPyEkjH9P4KspLFAi3fdWBkw8vZce51pbp

# Trade
BUY_AMOUNT_SOL=0.11
MAX_SIGNAL_AGE_SECONDS=5

# Mode: DEFAULT | AGGRESSIVE | SAFER
MODE=DEFAULT

# Exit (overrides mode if set)
TAKE_PROFIT_PERCENT=12
STOP_LOSS_PERCENT=7
MAX_HOLD_SECONDS=25

# Speed
SLIPPAGE_PERCENT=15
PRIORITY_FEE_MICRO_LAMPORTS=500000
JITO_TIP_SOL=0

# Test without spending SOL
DRY_RUN=true
